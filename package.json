{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor for Jungle Gaming Technical Challenge",
  "author": "Jungle Gaming Candidate",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "bun build ./src/main.ts --outdir ./dist --target node --packages=external",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:concurrency": "bun test tests/concurrency",
    "test:all": "bun test",
    "test:load": "bun run tests/load/load-test.ts",
    "migration:create": "bun mikro-orm migration:create",
    "migration:up": "bun mikro-orm migration:up",
    "migration:down": "bun mikro-orm migration:down",
    "migration:fresh": "bun mikro-orm migration:fresh"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.670.0",
    "@mikro-orm/cli": "^6.3.13",
    "@mikro-orm/core": "^6.3.13",
    "@mikro-orm/migrations": "^6.3.13",
    "@mikro-orm/postgresql": "^6.3.13",
    "@mikro-orm/reflection": "^6.3.13",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "autocannon": "^7.15.0",
    "typescript": "^5.6.3"
  }
}

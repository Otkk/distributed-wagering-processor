# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
AUTO_MIGRATE=true

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wagering_db
DB_POOL_MIN=2
DB_POOL_MAX=25

# AWS SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_OUTBOX_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo

# Workers & Retry Policies
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_DURATION_MS=30000
PENDING_REF_POLL_INTERVAL_MS=2000
PENDING_REF_MAX_ATTEMPTS=5
PENDING_REF_TTL_MS=60000
